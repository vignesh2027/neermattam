# Copy to .env (gitignored) and fill in. Never commit .env or print its values.

# Muse Spark Open on Baseten (perception)
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_MODEL=

# The hosted Meta Model API (perception, when that account can make calls)
MODEL_API_KEY=

# SAM 2.1 on the Modal service (perception, optional)
MODAL_SAM_URL=
MODAL_SAM_TOKEN=

# Ed25519 seed that signs measurement certificates (perception only): 32 random
# bytes, base64url. Without it perception signs with a key that lasts only until
# it restarts. To add one to .env without printing it (then delete this empty line):
#   python3 -c 'import base64,os;print("NEERMATTAM_SIGNING_KEY="+base64.urlsafe_b64encode(os.urandom(32)).rstrip(b"=").decode())' >> .env
NEERMATTAM_SIGNING_KEY=

# Web Push key pair for street alerts (gateway)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The control room's access key (gateway, at least 12 characters)
CONTROL_ROOM_KEY=

# Optional: pin the certificate public keys the gateway trusts (comma-separated
# base64url), instead of fetching them from perception.
CERTIFICATE_PUBLIC_KEYS=

# A developer API key for clients (not a server setting)
DEMO_API_KEY=
